<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the AI Infrastructure Unwinding Monitor weekly refresh.
  Runs scripts/weekly_refresh_cli.sh every Monday at 08:30 local time, which
  invokes Claude Code headlessly to research + refresh data/*.json and push to
  main (auto-deploys). Install with: bash scripts/launchd/install.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wesluo.ai-unwinding-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/wesl/Documents/AI Monitor/scripts/weekly_refresh_cli.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/wesl/Library/Logs/ai-unwinding-monitor/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wesl/Library/Logs/ai-unwinding-monitor/launchd.err.log</string>
</dict>
</plist>
